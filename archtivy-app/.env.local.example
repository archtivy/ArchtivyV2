# Clerk (https://clerk.com) – optional for local run; use placeholders until you add keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx

# Supabase (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by Server Actions and /api/explore (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mapbox (https://mapbox.com) – for /explore map
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
# Server-only Mapbox token for admin mapbox suggest API (falls back to NEXT_PUBLIC_MAPBOX_TOKEN)
MAPBOX_TOKEN=pk.your-mapbox-public-token

# Stripe (https://stripe.com) – visibility boost payments
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# ── SEO / indexing ────────────────────────────────────────────────────────────
# Canonical origin. REQUIRED in production: it drives canonical tags, sitemap
# <loc> values and the robots.txt Sitemap: line. Must include the protocol and
# no trailing slash. Production code falls back to https://www.archtivy.com if
# unset, but set it explicitly.
NEXT_PUBLIC_SITE_URL=https://www.archtivy.com

# Pins <lastmod> for static sitemap pages (ISO date). Avoids telling Google
# every marketing page changed today. Defaults to 2026-03-01.
# SITEMAP_LASTMOD=2026-03-01

# IndexNow key (Bing/Yandex push notifications). Optional — when unset,
# src/lib/seo/indexnow.ts is a no-op. Google has no equivalent push API.
# INDEXNOW_KEY=

# Set to 1 or true to serve a 503 maintenance response for all non-passthrough
# routes. LEAVE UNSET IN PRODUCTION — enabling it removes the site from Google.
# MAINTENANCE_MODE=

# Resend (https://resend.com) – leads notifications + curated introductions
RESEND_API_KEY=re_xxxx
# Admin email: receives "Lead Pending Review" when a visitor submits a contact form
ADMIN_EMAIL=admin@example.com
# From address for lead emails (must be verified in Resend)
FROM_EMAIL=Archtivy <introductions@archtivy.com>
